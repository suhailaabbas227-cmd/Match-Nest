{
  "expo": {
    "name": "MatchNest",
    "slug": "matchnest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/matchnest-logo.png",
    "scheme": "matchnest",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/matchnest-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff7fb"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.matchnest.app"
    },
    "android": {
      "package": "com.matchnest.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/matchnest-logo.png",
        "backgroundColor": "#fff7fb"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-linking"]
  }
}
