{
  "expo": {
    "name": "The Match Nest",
    "slug": "the-match-nest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/matchnest-logo.png",
    "scheme": "thematchnest",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/matchnest-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#fff7fb"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thematchnest.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.thematchnest.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/matchnest-logo.png",
        "backgroundColor": "#fff7fb"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The Match Nest uses the photo you choose for your member profile.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
